import QtQuick
import QtTest

Item {
    width: 1180
    height: 720
    Item {
        id: win
        anchors.fill: parent
        property var placesInfo: ({})
        property var deviceList: []
        property var connectedPlaces: []
        property var lostPlaces: []
        property var seenLostRoutes: []
        property var dirModel: ({places_json: "{}", location: "/local"})
        property var confirm: ({visible: false})
        property var prompt: ({visible: false, claimingFocus: false, promptCalls: 0,
            openWith: function() { this.visible = true; this.promptCalls += 1 },
            close: function() { this.visible = false }})
        QtObject { id: palette; property bool visible: false }
        property var quickLook: ({open: false})
        property var conflictDialog: ({visible: false})
        property var contextMenu: ({open: false})
        property var settingsPanel: ({open: false})
        property var renameCard: ({open: false})
        property var trashPanel: ({open: false})
        property var recentPanel: ({open: false})
        property var filterInput: ({activeFocus: false})
        property var searchInput: ({activeFocus: false})
        property int recoveryOpened: 0
        QtObject {
            id: connectionRecovery
            property bool visible: false
            property string routeKey: ""
            function open(title, body, button, danger) { win.recoveryOpened += 1 }
        }
        property string alertText: ""
        property var connectionOwner: null
        property string shareAddress: ""
        property string shareUser: ""
        property var pendingTailnet: null
        property string pendingTailnetUser: ""
        property var hints: ({message: ""})
        QtObject {
            id: fakeModel
            property bool place_busy: false
            property string places_json: "{}"
            property string location: "/local"
            property string returnError: ""
            property int connectCalls: 0
            property int installCalls: 0
            property int phoneCalls: 0
            property int phoneCancelCalls: 0
            property int navigationCalls: 0
            property int cloudSetupCalls: 0
            function navigate(path) { navigationCalls += 1 }
            function phone_open(id, apps) { phoneCalls += 1; return "" }
            function phone_cancel(id) { phoneCancelCalls += 1 }
            function request_devices() {}
            function install_support(key) { installCalls += 1; place_busy = returnError === ""; return returnError }
            function remote_connect(name) { connectCalls += 1; place_busy = returnError === ""; return returnError }
            function cloud_connect(name) { return remote_connect(name) }
            function tailnet_connect(name, target, user, trust) { return remote_connect(name) }
            function cloud_setup() { cloudSetupCalls += 1; return returnError }
            function share_check(address) { return "" }
            function share_mount(address, user, domain, password) { return remote_connect(address) }
            function request_places() {}
        }
        function cloudSetupAction() { const a = "cloud-setup"; if (false) {} @CLOUD_BRANCH@ }
        function runAction(action) {
            if (action.startsWith("remote-on:")) dirModel.remote_connect(action.substring(10))
            else if (action === "cloud-setup") cloudSetupAction()
        }
        function forgetConflictOwner(model) {}
        function refreshActiveModel() {}
        function removeModel(index, object) { @OBJECT_REMOVED@ }
        function refreshPlaces() {}
        @CONNECTION_FUNCTIONS@
        function qaDump(tag) {}
        function runningJobModels() { return [] }
        @PLACES_ARRIVED@
        ConnectPanel { id: connectPanel; places: win.placesInfo; @CONNECT_HANDLER@ @ACTION_HANDLER@ }
    }
    ConfirmDialog { id: recovery; preferCancel: true }
    SignalSpy { id: accepted; target: recovery; signalName: "accepted" }
    SignalSpy { id: rejected; target: recovery; signalName: "rejected" }
    TestCase {
    id: test
    name: "ConnectionController"
    when: windowShown
    function route(kind, name, lost) {
        return {kind: kind, name: name, detail: name, path: "/fixture/" + kind,
                connected: true, lost: lost, online: true, available: true}
    }
    function init() {
        win.seenLostRoutes = []; win.recoveryOpened = 0
        win.filterInput = {activeFocus: false}; win.searchInput = {activeFocus: false}
        accepted.clear(); rejected.clear()
        connectPanel.operation = null; connectPanel.feedbackTitle = ""; connectPanel.feedbackBody = ""; connectPanel.feedbackFailed = false
        connectPanel.hide(); connectPanel.supportKey = ""; win.connectionOwner = null; win.dirModel = fakeModel
        fakeModel.place_busy = false; fakeModel.returnError = ""; fakeModel.connectCalls = 0
        win.placesInfo = {sshfs: true, computers: [{name: "studio", routes: [
            {kind: "ssh", name: "studio-lan", detail: "192.0.2.10", online: true, connected: false}]}]}

    }
    function recoveryFixture() {
        const ssh = route("ssh", "studio-lan", false)
        const tail = route("tailnet", "studio", true)
        win.dirModel = {location: tail.path, places_json: JSON.stringify({
            computers: [{name: "Studio", routes: [ssh, tail]}], ssh: [ssh], tailnet: [tail], cloud: []})}
    }
    function test_lost_mounts_remain_sidebar_disconnect_targets_data() {
        return [{tag: "recovered", healthy: true}, {tag: "all-lost", healthy: false}]
    }
    function test_lost_mounts_remain_sidebar_disconnect_targets(row) {
        const routes = [route("ssh", "studio-old", true), route("tailnet", "studio", !row.healthy),
                        route("ssh", "studio-second", true)]
        fakeModel.places_json = JSON.stringify({computers: [{name: "Studio", routes: routes}],
            ssh: [routes[0], routes[2]], tailnet: [routes[1]], cloud: []})
        win.placesArrived()
        compare(win.connectedPlaces.length, 3, "A healthy alternative must not hide other still-mounted lost routes")
        compare(win.connectedPlaces.map(p => p.kind + ":" + p.name).sort().join(","),
                routes.map(p => p.kind + ":" + p.name).sort().join(","))
        compare(win.connectedPlaces.filter(p => p.lost).length, row.healthy ? 2 : 3)
        compare(fakeModel.connectCalls, 0, "Projecting mounts never retries a connection")
    }
    function test_worker_discovered_missing_support_retains_install_context_data() {
        return [{tag: "ssh", kind: "ssh", key: "ssh", op: "remote-connect", packageName: "openssh"},
                {tag: "cloud", kind: "cloud", key: "cloud", op: "cloud-connect", packageName: "rclone"},
                {tag: "tailnet", kind: "tailnet", key: "ssh", op: "tailnet-connect", packageName: "fuse3"}]
    }
    function test_worker_discovered_missing_support_retains_install_context(row) {
        win.placesInfo = {sshfs: true, setup: [{key: row.key, packages: [], installable: true}]}
        win.connectPlace(row.kind, "fixture", "192.0.2.10", "fixture-user")
        if (row.kind === "tailnet") win.tailnetUserEntered("fixture-user")
        compare(fakeModel.connectCalls, 1)
        fakeModel.place_busy = false
        win.finishPlaceFeedback(row.op, "fixture", "A required helper is missing", fakeModel)
        win.placesInfo = {setup: [{key: row.key, packages: [row.packageName], installable: true}]}
        verify(connectPanel.missingSupport, "A worker failure must keep an actionable setup context")
        compare(connectPanel.requirement.key, row.key)
    }
    function test_cloud_setup_failure_is_prominent_and_keeps_setup_context() {
        win.placesInfo = {setup: [{key: "cloud", packages: [], installable: true}]}
        fakeModel.returnError = "rclone is no longer available"
        win.cloudSetupAction()
        verify(connectPanel.open, "A failed setup launch must not disappear into a status line")
        compare(connectPanel.feedbackBody, fakeModel.returnError)
        win.placesInfo = {setup: [{key: "cloud", packages: ["rclone"], installable: true}]}
        verify(connectPanel.missingSupport)
        compare(connectPanel.requirement.key, "cloud")
    }
    function test_add_cloud_offers_helper_setup_before_starting_a_terminal() {
        fakeModel.cloudSetupCalls = 0
        win.placesInfo = {setup: [{key: "cloud", packages: ["rclone"], installable: true}]}
        win.cloudSetupAction()
        compare(fakeModel.cloudSetupCalls, 0, "Missing rclone must lead to Install support")
        compare(connectPanel.requirement.key, "cloud")
    }
    function test_share_setup_precedes_credentials_and_mount_data() {
        return [{tag: "smb", address: "//server/share", key: "smb"},
                {tag: "nfs", address: "nfs://server/export", key: "nfs"}]
    }
    function test_share_setup_precedes_credentials_and_mount(row) {
        win.prompt.promptCalls = 0
        win.placesInfo = {setup: [{key: row.key, packages: ["gvfs-" + row.key], installable: true}]}
        win.shareAddressEntered(row.address)
        compare(fakeModel.connectCalls, 0, "Missing sharing backend must not start a mount")
        compare(win.prompt.promptCalls, 0, "Do not ask for passwords before support is ready")
        verify(connectPanel.requirement !== null)
        compare(connectPanel.requirement.key, row.key)
    }
    function test_photos_menu_does_not_reopen_the_last_app_folder() {
        fakeModel.phoneCalls = 0; fakeModel.navigationCalls = 0
        win.deviceList = [{name: "apple:fixture", phone: "apple", stateKey: "open", label: "iPhone", mountPoint: "/fixture/app-files"}]
        win.openPhone("apple:fixture", "open", false, true)
        compare(fakeModel.navigationCalls, 0, "The Photos menu is not navigation to an app-files mount")
        compare(fakeModel.phoneCalls, 1, "Explicit Photos must ask the backend for the media URI")
    }
    function test_context_menu_open_does_not_cancel_an_existing_phone_attempt() {
        fakeModel.phoneCalls = 0; fakeModel.phoneCancelCalls = 0
        win.deviceList = [{name: "apple:fixture", phone: "apple", stateKey: "opening", label: "iPhone"}]
        win.openPhone("apple:fixture", "opening", false, true)
        compare(fakeModel.phoneCancelCalls, 0, "A menu item labelled Open must not mean Cancel")
        compare(fakeModel.phoneCalls, 0, "Do not start another attempt while one is opening")
    }
    function test_ready_snapshot_overrides_an_old_missing_package_row() {
        fakeModel.phoneCalls = 0
        win.deviceList = [{name: "apple:fixture", phone: "apple", stateKey: "needs-package", label: "iPhone"}]
        win.placesInfo = {setup: [{key: "apple", packages: [], installable: true}]}
        win.openPhone("apple:fixture", "needs-package")
        compare(fakeModel.phoneCalls, 1, "A fresh ready snapshot must let the explicit Open proceed")
    }
    function test_worker_missing_support_result_retains_the_install_action() {
        win.deviceList = [{name: "apple:fixture", phone: "apple", stateKey: "ready", label: "iPhone"}]
        win.placesInfo = {setup: [{key: "apple", packages: [], installable: true}]}
        win.openPhone("apple:fixture", "ready")
        win.placesInfo = {setup: [{key: "apple", packages: ["gvfs-afc"], installable: true}]}
        win.placeDone("phone-open", "apple:fixture", "Set up device", fakeModel)
        const install = findChild(connectPanel, "connectionInstallSupport")
        verify(install && install.visible, "A worker-discovered missing backend must retain the right setup action")
    }
    function test_other_transport_requirements_are_checked_before_network_calls_data() {
        return [{tag: "ssh-without-fuse", kind: "ssh", key: "ssh", packages: ["fuse3"]},
                {tag: "cloud-without-rclone", kind: "cloud", key: "cloud", packages: ["rclone"]}]
    }
    function test_other_transport_requirements_are_checked_before_network_calls(row) {
        win.placesInfo = {sshfs: true, setup: [{key: row.key, packages: row.packages, installable: true}]}
        win.connectPlace(row.kind, "studio", "192.0.2.10", "media")
        compare(fakeModel.connectCalls, 0, "All prerequisites, not just sshfs, must be checked before connecting")
        compare(connectPanel.requirement.key, row.key)
        compare(connectPanel.missingSupport, true)
    }
    function test_opening_a_phone_keeps_unlock_and_trust_guidance_prominent() {
        fakeModel.phoneCalls = 0
        win.deviceList = [{name: "apple:fixture", phone: "apple", stateKey: "ready", label: "iPhone"}]
        win.placesInfo = {setup: [{key: "apple", packages: [], installable: true}]}
        win.openPhone("apple:fixture", "ready")
        compare(fakeModel.phoneCalls, 1)
        compare(connectPanel.open, true, "Phone setup progress must not be a tiny sidebar/status line")
        compare(connectPanel.busy, true)
        verify(connectPanel.statusBody.indexOf("Trust") >= 0)
        connectPanel.hide()
        win.placeDone("phone-open", "apple:fixture", "Device is locked", fakeModel)
        compare(connectPanel.open, false, "Late phone failure must not reopen the panel")
        connectPanel.show()
        compare(connectPanel.statusBody, "Device is locked")
    }
    function test_phone_missing_backend_opens_setup_without_attempting_a_mount() {
        fakeModel.phoneCalls = 0
        win.deviceList = [{name: "apple:fixture", phone: "apple", stateKey: "needs-package", label: "iPhone"}]
        win.placesInfo = {setup: [{key: "apple", packages: ["gvfs-afc"], installable: true}]}
        win.openPhone("apple:fixture", "needs-package")
        compare(fakeModel.phoneCalls, 0, "Missing backend must lead to setup, not a doomed mount")
        compare(connectPanel.open, true)
        compare(connectPanel.statusTitle, "Set up Apple devices")
        verify(connectPanel.missingSupport)
    }
    function test_install_action_uses_initiating_owner_and_never_connects() {
        fakeModel.installCalls = 0
        win.placesInfo = {sshfs: true, setup: [{key: "apple", packages: ["gvfs-afc"], installable: true}]}
        connectPanel.showSupport("apple"); wait(0)
        connectPanel.installSupport()
        compare(fakeModel.installCalls, 1, "The actual panel action must reach the installer bridge")
        compare(fakeModel.connectCalls, 0)
        compare(connectPanel.busy, true)
        win.placeDone("setup-install", "apple", "", {place_busy: false})
        compare(connectPanel.busy, true, "Unrelated results must not complete setup")
        win.placeDone("setup-install", "apple", "", fakeModel)
        compare(connectPanel.busy, false)
        compare(connectPanel.open, true)
        compare(connectPanel.statusTitle, "Support is ready")
        verify(connectPanel.statusBody.indexOf("Reconnect") >= 0)
        compare(fakeModel.connectCalls, 0, "Successful installation never mounts the phone")
    }
    function test_missing_tool_does_not_close_panel_or_start_a_connection() {
        win.placesInfo = Object.assign({}, win.placesInfo, {sshfs: false})
        connectPanel.show(); wait(0)
        connectPanel.activate(connectPanel.rows.findIndex(r => r.type === "place"))
        compare(connectPanel.open, true, "A prerequisite refusal stays where Connect was clicked")
        compare(fakeModel.connectCalls, 0, "Missing tool must be caught before network work")
        verify(connectPanel.statusBody.indexOf("sshfs") >= 0)
        verify(connectPanel.statusBody.indexOf("sudo pacman") < 0)
    }
    function test_actual_connect_handler_tracks_the_matching_worker_result() {
        connectPanel.show(); wait(0)
        connectPanel.activate(connectPanel.rows.findIndex(r => r.type === "place"))
        compare(fakeModel.connectCalls, 1)
        compare(connectPanel.busy, true, "The real Connect handler must show progress")
        compare(connectPanel.open, true)
        const unrelated = {place_busy: false}
        win.placeDone("remote-connect", "studio-lan", "Other tab failed", unrelated)
        compare(connectPanel.busy, true, "Other tabs cannot complete this attempt")
        win.placeDone("remote-connect", "studio-lan", "Connection refused", fakeModel)
        compare(connectPanel.busy, false)
        compare(connectPanel.open, true)
        compare(connectPanel.statusBody, "Connection refused")
    }
    function test_tailnet_login_keeps_progress_and_inline_validation_failure() {
        win.pendingTailnet = {name: "studio", target: "192.0.2.10", model: fakeModel}
        fakeModel.returnError = "That is not a usable login name."
        connectPanel.show(); wait(0)
        win.tailnetUserEntered("invalid login")
        compare(connectPanel.open, true, "Validation failure must not disappear into the status bar")
        compare(connectPanel.busy, false)
        compare(connectPanel.statusBody, fakeModel.returnError)
        verify(connectPanel.feedbackFailed)
    }
    function test_cloud_setup_failure_is_visible_in_the_connect_panel() {
        fakeModel.returnError = "Cloud storage needs rclone. Install it and check again."
        connectPanel.show(); wait(0)
        connectPanel.activate(connectPanel.rows.findIndex(r => r.action === "cloud-setup"))
        compare(connectPanel.open, true)
        compare(connectPanel.statusBody, fakeModel.returnError)
        compare(connectPanel.feedbackFailed, true)
    }
    function test_nfs_share_validation_and_worker_errors_stay_in_context() {
        fakeModel.returnError = "Sharing support is not installed."
        connectPanel.show(); wait(0)
        win.shareAddressEntered("nfs://192.0.2.10/export")
        compare(fakeModel.connectCalls, 1)
        compare(connectPanel.statusBody, fakeModel.returnError)
        compare(connectPanel.open, true)
    }
    function test_closing_the_initiating_tab_releases_progress_without_claiming_cancellation() {
        connectPanel.show(); wait(0)
        win.connectPlace("ssh", "studio-lan", "", "")
        compare(connectPanel.busy, true)
        win.removeModel(0, fakeModel)
        compare(connectPanel.busy, false)
        verify(connectPanel.statusBody.indexOf("unknown") >= 0, "Closing a tab is not proof that the worker cancelled")
    }
    function test_a_duplicate_from_the_palette_reopens_the_existing_progress() {
        win.connectPlace("ssh", "studio-lan", "", "")
        compare(connectPanel.busy, true)
        const title = connectPanel.statusTitle
        connectPanel.hide()
        win.connectPlace("cloud", "different-storage", "", "")
        compare(connectPanel.open, true, "A refused attempt must show the one already running")
        compare(connectPanel.statusTitle, title)
        compare(fakeModel.connectCalls, 1)
    }
    function test_trust_for_a_closed_owner_explains_why_it_did_not_start() {
        connectPanel.hide()
        win.startTailnetAttempt(null, "media", true)
        compare(connectPanel.open, true)
        verify(connectPanel.statusBody.indexOf("Choose the computer again") >= 0)
        compare(fakeModel.connectCalls, 0)
    }
    function test_filter_typing_does_not_lose_focus_to_recovery() {
        recoveryFixture(); win.filterInput = {activeFocus: true}
        win.placesArrived()
        compare(win.recoveryOpened, 0)
    }
    function test_search_typing_does_not_lose_focus_to_recovery() {
        recoveryFixture(); win.searchInput = {activeFocus: true}
        win.placesArrived()
        compare(win.recoveryOpened, 0)
    }
    function test_idle_recovery_only_offers_a_choice() {
        recoveryFixture(); win.placesArrived()
        compare(win.recoveryOpened, 1)
        compare(connectionRecovery.routeKey, "tailnet:studio")
    }
    function cleanup() { recovery.close() }
    function test_healthy_alternative_keeps_a_lost_mount_accessible() {
        const ssh = route("ssh", "studio-lan", false)
        const tail = route("tailnet", "studio", true)
        win.dirModel = {location: "/local", places_json: JSON.stringify({
            computers: [{name: "Studio", routes: [ssh, tail]}], ssh: [ssh], tailnet: [tail], cloud: []})}
        win.placesArrived()
        compare(win.connectedPlaces.length, 2, "One computer summary plus its still-mounted lost route")
        compare(win.connectedPlaces[1].name, "studio")
        compare(win.connectedPlaces[1].lost, true)
        compare(win.connectedPlaces[0].kind, "ssh")
        compare(win.connectedPlaces[0].name, "studio-lan", "Actions retain route alias")
        compare(win.connectedPlaces[0].label, "Studio", "Display retains computer name")
        compare(win.connectedPlaces[0].lost, false)
    }
    function test_equal_labels_do_not_merge_unrelated_computers() {
        const ssh = route("ssh", "studio", false)
        const tail = route("tailnet", "studio", false)
        win.dirModel = {location: "/local", places_json: JSON.stringify({
            computers: [{name: "Studio", routes: [ssh]}, {name: "Studio", routes: [tail]}],
            ssh: [ssh], tailnet: [tail], cloud: []})}
        win.placesArrived()
        compare(win.connectedPlaces.length, 2)
    }
    function test_recovery_enter_cancels_without_danger_styling() {
        recovery.open("Connection lost", "Choose another connection", "Choose connection", false)
        compare(recovery.dangerous, false)
        keyClick(Qt.Key_Return)
        compare(rejected.count, 1)
        compare(accepted.count, 0)
    }
    function test_recovery_pointer_buttons_remain_distinct() {
        recovery.open("Connection lost", "Choose another connection", "Choose connection", false)
        waitForRendering(recovery)
        let p = recovery.buttonCenters()
        mouseClick(recovery, p.cancel[0], p.cancel[1])
        compare(rejected.count, 1)
        compare(accepted.count, 0)
        recovery.open("Connection lost", "Choose another connection", "Choose connection", false)
        waitForRendering(recovery)
        p = recovery.buttonCenters()
        mouseClick(recovery, p.confirm[0], p.confirm[1])
        compare(accepted.count, 1)
        compare(rejected.count, 1)
    }
    }
}
