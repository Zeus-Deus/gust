import QtQuick
import QtTest

// Exact Main.qml close, tab-close and disconnect guards (inserted by
// crates/app/tests/work_guard_regressions.py) against synthetic models.
// A model's work is plain properties here; the real DirModel answers the
// same questions from its job handle and archive claims.
TestCase {
    name: "WorkGuard"

    component FakeModel: QtObject {
        property string status: "fixture status"
        property int runToken: 0
        property string runName: "b.sh"
        property string runState: "allow"
        property var launches: []
        property var discarded: []
        function run_prepare(row) {
            runToken += 1
            return JSON.stringify({ token: runToken, name: runName, state: runState })
        }
        function run_confirm(token, allow) { launches = launches.concat([{token: token, allow: allow}]); return "" }
        function run_discard(token) { discarded = discarded.concat([token]) }
        property bool running: false
        property bool stopping: false
        property bool archive: false
        property bool sharing_busy: false
        // A permissions change: no cancel, held until its outcome and undo
        // have been handled (DirModel::permissions_running).
        property bool perms: false
        property string place: ""
        property int cancels: 0
        function job_running() { return running }
        function archive_running() { return archive }
        function permissions_running() { return perms }
        // Cancel is a REQUEST: the worker keeps running until the test says
        // its remote call returned.
        function cancel_job() { cancels += 1; if (running || sharing_busy) stopping = true }
        function work_on_place(kind, name) {
            if (name !== place) return ""
            if (running) return stopping ? "stopping" : "transfer"
            return archive ? "archive" : perms ? "permissions" : ""
        }
    }

    FakeModel { id: modelA }
    FakeModel { id: modelB }
    FakeModel { id: modelC }

    property var dirModel: modelA

    Item {
        id: win
        property bool closing: false
        property bool closeNow: false
        property int quitCalls: 0
        property var job: null
        property string alertText: ""
        property int activeTab: 0
        property int activePane: 0
        property int paneCount: 1
        property var paneTab: [0, -1]
        property var tabViews: []
        property int pendingCloseTab: -1
        property string pendingCloudOff: ""
        property int pendingTrashRow: -1
        property var pendingRunModel: null
        property int pendingRunToken: 0
        property var models: [modelA, modelB, modelC]
        property var dumps: []
        function qaDump(tag) { dumps = dumps.concat([tag]) }
        function focusList() {}
        function activateTab(i) {}
        function refreshPaneTabCount() {}
        function closePane(p) {}
        function paneTabs(p) {
            const out = []
            for (let i = 0; i < tabList.count; i++) if (tabList.get(i).pane === p) out.push(i)
            return out
        }
        function tabModelAt(i) { return tabs.objectAt(i) }
        function handleClosing(close) {
@CLOSING_HANDLER@
        }
        function confirmAccepted() {
@CONFIRM_ACCEPTED@
        }
        function confirmRejected() {
@CONFIRM_REJECTED@
        }
@FUNCTIONS@
    }

    ListModel { id: tabList }
    QtObject {
        id: tabs
        function objectAt(i) {
            return i >= 0 && i < tabList.count ? win.models[tabList.get(i).slot] : null
        }
    }
    QtObject { id: hints; property string message: "" }
    QtObject {
        id: connectPanel
        property bool open: false
        property string title: ""
        property string body: ""
        function showFeedback(t, b, failed) { title = t; body = b; open = true }
    }
    QtObject {
        id: confirm
        property string purpose: "trash"
        property string title: ""
        property string body: ""
        property string confirmText: ""
        property bool dangerous: false
        property int opens: 0
        function open(t, b, c, danger) { title = t; body = b; confirmText = c; dangerous = danger; opens += 1 }
    }
@TIMERS@

    function init() {
        for (const m of win.models) {
            m.running = false; m.stopping = false; m.archive = false; m.sharing_busy = false; m.perms = false
            m.place = ""; m.cancels = 0
        }
        closeAfterCancel.stop(); closeAfterCancel.ticks = 0
        closeTabAfterCancel.stop(); closeTabAfterCancel.models = []
        tabList.clear()
        for (let i = 0; i < 3; i++) tabList.append({slot: i, pane: 0})
        win.tabViews = ["rows", "rows", "rows"]
        win.activeTab = 0
        win.closing = false; win.closeNow = false; win.quitCalls = 0
        win.alertText = ""; win.dumps = []
        confirm.purpose = "trash"; confirm.opens = 0
        connectPanel.open = false
        hints.message = ""
    }

    // Nothing may promise what happens to the unfinished item: a remote
    // place may keep temporary files on purpose, and cleanup can fail.
    function verifyNoCleanupPromise(text) {
        verify(!/discard|remov|clean/i.test(text), text)
    }

    function tickWindow(n) { for (let i = 0; i < n; i++) closeAfterCancel.triggered() }
    function tickTabs(n) { for (let i = 0; i < n; i++) closeTabAfterCancel.triggered() }

    function test_run_confirmation_keeps_originating_model_and_token() {
        dirModel = modelA
        modelA.launches = []; modelB.launches = []
        modelA.runName = "b.sh"; modelA.runState = "allow"
        win.askRun(1)
        const token = win.pendingRunToken
        compare(confirm.title, "Allow b.sh to run?")
        compare(win.pendingRunModel, modelA)
        // An active-tab change and a reordered listing cannot change consent.
        dirModel = modelB
        modelA.runName = "aa.sh"
        win.confirmAccepted()
        compare(modelA.launches.length, 1)
        compare(modelA.launches[0].token, token)
        verify(modelA.launches[0].allow)
        compare(modelB.launches.length, 0)
        compare(win.pendingRunModel, null)
        compare(win.pendingRunToken, 0)
        dirModel = modelA
        modelA.runName = "b.sh"; modelA.runState = "run"
        win.askRun(1)
        const cancelled = win.pendingRunToken
        dirModel = modelB
        win.confirmRejected()
        compare(modelA.discarded[modelA.discarded.length - 1], cancelled)
        compare(modelA.launches.length, 1)
        compare(modelB.launches.length, 0)
        compare(win.pendingRunModel, null)
        dirModel = modelA
    }

    function test_window_keeps_a_sharing_worker_until_cancellation_is_acknowledged() {
        modelB.sharing_busy = true
        const close = {accepted: true}
        win.handleClosing(close)
        compare(close.accepted, false)
        compare(confirm.title, "File sharing is still running")
        verify(confirm.body.indexOf("may already have been accepted") >= 0)
        win.confirmAccepted()
        compare(modelB.cancels, 1)
        tickWindow(15)
        compare(win.quitCalls, 0)
        modelB.sharing_busy = false
        tickWindow(1)
        compare(win.quitCalls, 1)
    }

    function test_tab_keeps_a_sharing_worker_until_it_has_stopped() {
        modelB.sharing_busy = true
        win.closeTab(1)
        compare(tabList.count, 3)
        compare(confirm.title, "File sharing is still running")
        win.confirmAccepted()
        compare(modelB.cancels, 1)
        tickTabs(15)
        compare(tabList.count, 3)
        modelB.sharing_busy = false
        tickTabs(1)
        compare(tabList.count, 2)
    }

    function test_window_waits_for_an_actual_stop_however_long_it_takes() {
        modelB.running = true
        const close = {accepted: true}
        win.handleClosing(close)
        compare(close.accepted, false)
        compare(confirm.purpose, "close")
        verify(confirm.dangerous)
        verify(confirm.body.indexOf("asks it to stop") >= 0, confirm.body)
        verify(confirm.body.indexOf("temporary files") >= 0, confirm.body)
        verifyNoCleanupPromise(confirm.body)
        win.confirmAccepted()
        compare(modelB.cancels, 1)
        verify(modelB.stopping, "cancel is only a request")
        // Far past the old three-second fallback: still waiting.
        tickWindow(200)
        compare(win.quitCalls, 0, "the window must not quit while the worker is still stopping")
        verify(hints.message.indexOf("Still stopping") >= 0)
        modelB.running = false
        tickWindow(1)
        compare(win.quitCalls, 1)
    }

    function test_a_second_close_while_stopping_asks_before_abandoning() {
        modelA.running = true
        win.handleClosing({accepted: true})
        win.confirmAccepted()
        const again = {accepted: true}
        win.handleClosing(again)
        compare(again.accepted, false, "a second close must not skip the wait silently")
        compare(confirm.purpose, "closewait")
        verify(confirm.dangerous)
        verify(confirm.body.indexOf("temporary files") >= 0)
        verify(confirm.body.indexOf("Check the destination") >= 0)
        verifyNoCleanupPromise(confirm.body)
        // A finished move has already removed its originals, and a stuck
        // process may outlive the window: neither may be promised away.
        verify(confirm.body.indexOf("source") < 0, confirm.body)
        verify(confirm.body.indexOf("interrupted") < 0, confirm.body)
        win.confirmRejected()
        compare(win.quitCalls, 0)
        tickWindow(50)
        compare(win.quitCalls, 0)

        win.handleClosing({accepted: true})
        compare(confirm.purpose, "closewait")
        win.confirmAccepted()
        compare(win.quitCalls, 1, "closing without waiting is the user's explicit choice")
        verify(win.closeNow)
        const last = {accepted: true}
        win.handleClosing(last)
        compare(last.accepted, true)
    }

    function test_archive_work_holds_the_window_without_a_fake_cancel() {
        modelC.archive = true
        const close = {accepted: true}
        win.handleClosing(close)
        compare(close.accepted, false)
        compare(confirm.title, "Archive work is still running")
        compare(confirm.confirmText, "Close when finished")
        win.confirmAccepted()
        compare(modelC.cancels, 0)
        tickWindow(100)
        compare(win.quitCalls, 0)
        modelC.archive = false
        tickWindow(1)
        compare(win.quitCalls, 1)
    }

    function test_nothing_running_closes_at_once() {
        const close = {accepted: true}
        win.handleClosing(close)
        compare(close.accepted, true)
        compare(confirm.opens, 0)
    }

    function test_tab_stays_until_its_transfer_has_stopped() {
        modelB.running = true
        win.closeTab(1)
        compare(confirm.purpose, "closetab")
        verify(confirm.body.indexOf("asks it to stop") >= 0, confirm.body)
        verifyNoCleanupPromise(confirm.body)
        compare(tabList.count, 3)
        win.confirmAccepted()
        compare(modelB.cancels, 1)
        tickTabs(200)
        compare(tabList.count, 3, "the tab owns the job; removing it early drops a stop in flight")

        // Asking again neither re-asks nor skips the wait.
        const opens = confirm.opens
        win.closeTab(1)
        compare(confirm.opens, opens)
        compare(tabList.count, 3)
        verify(hints.message.indexOf("Still stopping") >= 0)

        // Another tab closing meanwhile shifts indexes; the right tab goes.
        win.closeTab(0)
        compare(tabList.count, 2)
        compare(win.tabModelAt(0), modelB)

        modelB.running = false
        tickTabs(1)
        compare(tabList.count, 1)
        compare(win.tabModelAt(0), modelC)
        verify(!closeTabAfterCancel.running)
    }

    function test_tab_with_archive_work_waits_without_a_fake_cancel() {
        modelC.archive = true
        win.closeTab(2)
        compare(confirm.purpose, "closetab")
        compare(confirm.confirmText, "Close when finished")
        verify(!confirm.dangerous)
        win.confirmAccepted()
        compare(modelC.cancels, 0, "archive work has no cancel to call")
        tickTabs(100)
        compare(tabList.count, 3)
        // The worker unwinds (finished, failed or panicked: its claim drops).
        modelC.archive = false
        tickTabs(1)
        compare(tabList.count, 2)
        verify(!closeTabAfterCancel.running)
    }

    function test_a_transfer_still_planning_holds_close_like_a_running_one() {
        // Planning is part of the job: DirModel reports job_running from
        // admission, before the first byte moves.
        modelA.running = true
        modelA.place = "nas"
        const close = {accepted: true}
        win.handleClosing(close)
        compare(close.accepted, false)
        compare(confirm.purpose, "close")
        verify(win.placeWorkBlocker("ssh", "nas").indexOf("still running") >= 0)
        win.confirmRejected()
        compare(modelA.cancels, 0, "Cancel in the dialog keeps the transfer")
        compare(win.quitCalls, 0)
    }

    function test_disconnect_is_refused_while_work_uses_the_place() {
        modelC.running = true
        modelC.place = "nas"
        verify(win.placeWorkBlocker("ssh", "nas").indexOf("still running") >= 0)
        compare(win.placeWorkBlocker("ssh", "other"), "")

        modelC.cancel_job()
        modelA.archive = true
        modelA.place = "nas"
        const why = win.placeWorkBlocker("ssh", "nas")
        verify(why.indexOf("still stopping") >= 0, "a stop in flight is not a stopped transfer: " + why)

        connectPanel.open = true
        verify(win.refuseBusyDisconnect("ssh", "nas"))
        compare(win.alertText, why)
        compare(connectPanel.body, why)

        modelC.running = false
        verify(win.placeWorkBlocker("ssh", "nas").indexOf("Archive work") === 0)
        modelA.archive = false
        compare(win.placeWorkBlocker("ssh", "nas"), "")
        verify(!win.refuseBusyDisconnect("ssh", "nas"))
    }

    function test_window_waits_for_a_permissions_change_it_cannot_stop() {
        modelB.perms = true
        const close = {accepted: true}
        win.handleClosing(close)
        compare(close.accepted, false, "a held permissions write must not be dropped by a close")
        compare(confirm.title, "Permissions are still being changed")
        compare(confirm.confirmText, "Close when finished")
        verify(!confirm.dangerous)
        verify(confirm.body.indexOf("cannot stop") >= 0, confirm.body)
        win.confirmAccepted()
        compare(modelB.cancels, 0, "a permissions change has no cancel to call")
        tickWindow(200)
        compare(win.quitCalls, 0, "the window waits for the outcome and its undo")

        // Closing again is the existing explicit choice, with its cost named.
        const again = {accepted: true}
        win.handleClosing(again)
        compare(again.accepted, false)
        compare(confirm.purpose, "closewait")
        verify(confirm.body.indexOf("Ctrl+Z cannot put it back") >= 0, confirm.body)
        win.confirmRejected()
        tickWindow(50)
        compare(win.quitCalls, 0)

        modelB.perms = false
        tickWindow(1)
        compare(win.quitCalls, 1)
    }

    function test_background_tab_keeps_its_permissions_change_until_handled() {
        // The change belongs to tab 2 while tab 0 is on screen.
        win.activeTab = 0
        modelC.perms = true
        win.closeTab(2)
        compare(tabList.count, 3)
        compare(confirm.purpose, "closetab")
        compare(confirm.title, "Permissions are still being changed")
        compare(confirm.confirmText, "Close when finished")
        verify(!confirm.dangerous)
        win.confirmAccepted()
        compare(modelC.cancels, 0)
        tickTabs(100)
        compare(tabList.count, 3, "the tab owns the change; removing it drops the report and the undo")

        // A repeated close neither re-asks nor skips the wait.
        const opens = confirm.opens
        win.closeTab(2)
        compare(confirm.opens, opens)
        compare(tabList.count, 3)

        modelC.perms = false
        tickTabs(1)
        compare(tabList.count, 2)
        compare(win.tabModelAt(1), modelB)
        verify(!closeTabAfterCancel.running)
    }

    function test_tabs_finish_independently_while_other_permissions_are_pending() {
        modelB.perms = true
        modelC.perms = true
        win.closeTab(1)
        win.confirmAccepted()
        win.closeTab(2)
        win.confirmAccepted()
        tickTabs(100)
        compare(tabList.count, 3)
        compare(closeTabAfterCancel.models.length, 2)

        modelB.perms = false
        tickTabs(1)
        compare(tabList.count, 2)
        compare(win.tabModelAt(1), modelC, "the other waiting tab shifts with the list")
        compare(closeTabAfterCancel.models.length, 1)
        compare(closeTabAfterCancel.models[0], modelC)
        verify(closeTabAfterCancel.running)
        tickTabs(100)
        compare(tabList.count, 2, "finishing one tab must not release the other's work")

        modelC.perms = false
        tickTabs(1)
        compare(tabList.count, 1)
        compare(win.tabModelAt(0), modelA)
        compare(closeTabAfterCancel.models.length, 0)
        verify(!closeTabAfterCancel.running)
    }

    function test_window_close_beside_a_transfer_also_waits_for_permissions() {
        modelA.running = true
        modelB.perms = true
        const close = {accepted: true}
        win.handleClosing(close)
        compare(close.accepted, false)
        compare(confirm.purpose, "close")
        verify(confirm.body.indexOf("permissions change cannot be stopped") >= 0, confirm.body)
        verify(confirm.body.indexOf("Archive work") < 0, "no archive is running: " + confirm.body)
        win.confirmAccepted()
        compare(modelA.cancels, 1)
        compare(modelB.cancels, 0)
        modelA.running = false
        tickWindow(20)
        compare(win.quitCalls, 0, "the stopped transfer is not the whole window's work")
        modelB.perms = false
        tickWindow(1)
        compare(win.quitCalls, 1)
    }

    function test_archive_and_permissions_together_are_both_named() {
        modelC.archive = true
        modelC.perms = true
        win.handleClosing({accepted: true})
        compare(confirm.title, "Archive work and a permissions change are still running")
        modelC.archive = false
        win.closeTab(2)
        compare(confirm.title, "Permissions are still being changed")
    }

    function test_disconnect_waits_for_a_permissions_change_on_the_place() {
        modelB.perms = true
        modelB.place = "nas"
        const why = win.placeWorkBlocker("ssh", "nas")
        verify(why.indexOf("Permissions on nas are still being changed") === 0, why)
        compare(win.placeWorkBlocker("ssh", "other"), "")
        verify(win.refuseBusyDisconnect("ssh", "nas"))
        compare(win.alertText, why)
        modelB.perms = false
        verify(!win.refuseBusyDisconnect("ssh", "nas"))
    }
}
